<Window x:Class="ChessXpress.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:ChessXpress"
mc:Ignorable="d"
Title="MainWindow" Height="814" Width="1655">

    <DockPanel>
        <Border BorderThickness="2" BorderBrush="Black">
            <Grid Width="410">
                <Grid.RowDefinitions>
                    <!-- Kopfzeile -->
                    <RowDefinition Height="Auto" />
                    <!-- Datenzeilen -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Kopfzeile -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0 0 1 1">
                        <TextBlock HorizontalAlignment="Center">WHITE</TextBlock>
                    </Border>
                    <Border Grid.Column="1" Background="Black" BorderBrush="Black" BorderThickness="0 0 0 1">
                        <TextBlock HorizontalAlignment="Center" Foreground="White">BLACK</TextBlock>
                    </Border>
                </Grid>
                <!-- Datenzeilen -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl HorizontalAlignment="Center" Grid.Column="0" Name="whiteMovesTable">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Cursor="Hand" Foreground="Black" HorizontalAlignment="Center" Text="{Binding Move}" MouseLeftButtonDown="WhiteMove_MouseLeftButtonDown"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl HorizontalAlignment="Center" Grid.Column="1" Name="blackMovesTable">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Cursor="Hand" Foreground="Black" HorizontalAlignment="Center" Text="{Binding Move}" MouseLeftButtonDown="BlackMove_MouseLeftButtonDown"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        <DockPanel Width="700" Height="700">
            <Label DockPanel.Dock="Left" Width="30" Height="700">
                <StackPanel Orientation="Vertical" Height="700" Width="30">
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">8</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">7</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">6</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">5</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">4</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">3</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">2</TextBlock>
                    </Border>
                    <Border Height="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">1</TextBlock>
                    </Border>
                </StackPanel>
            </Label>
            <Label DockPanel.Dock="Bottom" Height="30" Width="670" Padding="0 0 0 0">
                <StackPanel Orientation="Horizontal" Width="640">
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">a</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">b</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">c</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">d</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">e</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">f</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">g</TextBlock>
                    </Border>
                    <Border Width="83.75">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="20">h</TextBlock>
                    </Border>
                </StackPanel>
            </Label>
            <Border BorderBrush="Black" BorderThickness="1">
                <Grid x:Name="Chessboard">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="BlackBrush" Color="#000000" />
                    </Grid.Resources>
                </Grid>
            </Border>
        </DockPanel>
        <StackPanel Height="700">
            <StackPanel Orientation="Horizontal" Width="350" Height="87.5" Margin="0 0 0 146.5" Visibility="Collapsed" Name="newWFigures">
                <Button Name="wqueen" Click="newFigure_init" Width="87.5" Background="Black" Cursor="Hand">
                    <Image Source="/img/figures/w-queen.png"/>
                </Button>
                <Button Name="wrock" Click="newFigure_init" Width="87.6" Background="Black" Cursor="Hand">
                    <Image Source="/img/figures/w-rock.png"/>
                </Button>
                <Button Name="wbishop" Click="newFigure_init" Width="87.5" Background="Black" Cursor="Hand">
                    <Image Source="/img/figures/w-bishop.png"/>
                </Button>
                <Button Name="wknight" Click="newFigure_init" Width="87.5" Background="Black" Cursor="Hand">
                    <Image Source="/img/figures/w-knight.png"/>
                </Button>
            </StackPanel>
            <StackPanel Name="TimerMenus" Width="300" Height="200" Margin="0 234 0 0">
                <StackPanel Name="TimerMenu">
                    <Border DockPanel.Dock="Top" Height="75" Background="Black">
                        <Border VerticalAlignment="Center" DockPanel.Dock="Top">
                            <TextBlock FontSize="50" TextAlignment="Center" Foreground="White" Name="blackText">00:00</TextBlock>
                        </Border>
                    </Border>
                    <Border BorderThickness="2 0 2 1" BorderBrush="Black" >
                        <StackPanel Orientation="Horizontal" Height="50">
                            <Button Click="restart_Click" Background="White" Cursor="Hand" Name="restartButton" BorderBrush="Black" BorderThickness="0 0 1 0">
                                <TextBlock Name="restartButtonContent" Width="100" FontSize="33" TextAlignment="Center">&#10227;</TextBlock>
                            </Button>
                            <Button Width="100" Background="White" Cursor="Hand" Click="startTimer_Click" Name="startInteractButton" BorderBrush="Black" BorderThickness="0 0 1 0">
                                <StackPanel>
                                    <Polygon Fill="Black" Points="0,0 30,25 0,50" HorizontalAlignment="Center" VerticalAlignment="Center" Name="StartButton">
                                        <Polygon.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="0.6" />
                                        </Polygon.LayoutTransform>
                                    </Polygon>
                                    <TextBlock Text="&#10074;&#10074;" FontSize="33" Foreground="Black" TextAlignment="Center" Name="PauseButton" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Width="95">
                                <Button Click="backButton_Click" Width="47.5" DockPanel.Dock="Left" Background="White" Cursor="Hand" Name="backButton" BorderBrush="Black" BorderThickness="0 0 1 0">
                                    <TextBlock Name="backButtonContent" FontSize="33" TextAlignment="Center">&#10094;</TextBlock>
                                </Button>
                                <Button Click="forwardButton_Click" Width="47.5" DockPanel.Dock="Right" Background="White" Cursor="Hand" Name="forwardButton" BorderThickness="0">
                                    <TextBlock Name="forwardButtonContent" FontSize="33" TextAlignment="Center">&#10095;</TextBlock>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Height="75" BorderBrush="Black" BorderThickness="2 0 2 2">
                        <Border VerticalAlignment="Center" DockPanel.Dock="Bottom">
                            <TextBlock FontSize="50" TextAlignment="Center" Name="whiteText">00:00</TextBlock>
                        </Border>
                    </Border>
                </StackPanel>
                <StackPanel Name="TimerStartMenu">
                    <Label Height="50" FontSize="30" HorizontalContentAlignment="Center">Uhr einstellen</Label>
                    <Slider Name="sliderMinutes" Width="200" Minimum="0" Maximum="90" ValueChanged="Slider_MinuteChanged" Cursor="Hand"/>
                    <Label Name="labelMinutes" Width="130" Height="40" FontSize="20" HorizontalContentAlignment="Center">0 Minuten</Label>
                    <Slider Name="sliderSeconds" Width="200" Minimum="0" Maximum="59" ValueChanged="Slider_SecondChanged" Cursor="Hand"/>
                    <Label Name="labelSeconds" Width="130" Height="40" FontSize="20" HorizontalContentAlignment="Center">0 Sekunden</Label>
                    <Button Height="34" FontSize="20" Click="init_Time_Click" Cursor="Hand">Start</Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="350" Height="87.5" Margin="0 146.5 0 0" Visibility="Collapsed" Name="newBFigures">
                <Button Name="bqueen" Click="newFigure_init" Width="87.5" Background="White" Cursor="Hand">
                    <Image Source="/img/figures/b-queen.png"/>
                </Button>
                <Button Name="brock" Click="newFigure_init" Width="87.5" Background="White" Cursor="Hand">
                    <Image Width="400" Source="/img/figures/b-rock.png"/>
                </Button>
                <Button Name="bbishop" Click="newFigure_init" Width="87.5" Background="White" Cursor="Hand">
                    <Image Width="350" Source="/img/figures/b-bishop.png"/>
                </Button>
                <Button Name="bknight" Click="newFigure_init" Width="87.5" Background="White" Cursor="Hand">
                    <Image Width="350" Source="/img/figures/b-knight.png"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
